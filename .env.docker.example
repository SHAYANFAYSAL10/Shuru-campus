# Optional settings for `docker compose up` (compose.yaml). Copy to `.env` in the repo root only
# if you want to change something; every value here has a working default.

# Where people open the site. Baked into the web build (canonical URLs, Open Graph) and used as
# the API's allowed origin. Rebuild after changing it: `docker compose up --build`.
SITE_URL=http://localhost:3000
# Host port for the site. Keep it in step with SITE_URL.
WEB_PORT=3000

ADMIN_EMAIL=admin@example.com

# Leave blank to have them generated on the first start: the admin password is printed once in
# the api log (`docker compose logs api`), and both are kept in the `api-secrets` volume.
# `docker compose down -v` deletes that volume, so you get a fresh password next time.
#
# At least 32 random bytes:
#   docker compose run --rm --no-deps api node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# argon2id hash of your own admin password (12+ characters):
#   docker compose run --rm --no-deps api node scripts/admin-hash.mjs 'a-strong-password'
# Keep the single quotes: the hash contains `$`, which compose would otherwise expand.
ADMIN_PASSWORD_HASH=''

JWT_TTL=8h
# Optional: fatal | error | warn | info | debug | trace | silent.
# LOG_LEVEL=info
