{
  "name": "campus",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint . && npm run format:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && npm run test:scripts",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "check:no-db": "node scripts/check-no-db.mjs",
    "check:brand": "node scripts/check-brand-literals.mjs",
    "check:guards": "npm run check:no-db && npm run check:brand",
    "admin:hash": "npm run admin:hash -w @campus/api --"
  },
  "devDependencies": {
    "@campus/eslint-config": "^0.0.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "unrs-resolver": false,
    "argon2": false,
    "@scarf/scarf": false
  }
}
