# API runtime configuration. Copy to .env and fill in.
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (CORS + Origin guard).
WEB_ORIGINS=http://localhost:3000
# At least 32 random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
JWT_SECRET=
JWT_TTL=8h
ADMIN_EMAIL=admin@example.com
# Generate with `npm run admin:hash -- <password>`.
ADMIN_PASSWORD_HASH=
# Phase 1 accepts only `memory`.
DATA_SOURCE=memory
# Optional: path to a JSON file overriding the default brand (validated at boot).
# BRAND_SEED=
# Optional: fatal | error | warn | info | debug | trace | silent.
# LOG_LEVEL=debug
# Which proxy hops may set X-Forwarded-For (rate limits key on the client IP).
TRUST_PROXY=loopback
# Per-IP limits per minute.
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_LOGIN_LIMIT=5
THROTTLE_INQUIRY_LIMIT=5
