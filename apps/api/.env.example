# API runtime configuration. Copy to .env and fill in.
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (CORS + Origin guard).
WEB_ORIGINS=http://localhost:3000
# At least 32 random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
JWT_SECRET=
JWT_TTL=8h
ADMIN_EMAIL=admin@example.com
# Generate with `npm run admin:hash -- <password>`.
ADMIN_PASSWORD_HASH=
# Phase 1 accepts only `memory`.
DATA_SOURCE=memory
# Optional: path to a JSON file overriding the default brand (validated at boot).
# BRAND_SEED=
