# Server-side only: where the Next server reaches the API (also the /api rewrite target).
API_ORIGIN=http://localhost:4000
# Canonical site URL used for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Build the dev-only /_styleguide into a production build (visual tests). Off by default.
ENABLE_STYLEGUIDE=false
